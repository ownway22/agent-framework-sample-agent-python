# This is a demo .env file
# Copy this file with: cp .env.template .env
# This repo uses Azure OpenAI in agent.py, so the Azure OpenAI variables below are required.
OPENAI_API_KEY=
MCP_SERVER_HOST=
MCP_PLATFORM_ENDPOINT=

# Authentication Handler Configuration
# Leave blank for local bearer-token testing.
# Set to "AGENTIC" only when you enable agentic auth below.
AUTH_HANDLER_NAME=

# Logging
LOG_LEVEL=INFO

# Observability Configuration
OBSERVABILITY_SERVICE_NAME=agent-framework-sample
OBSERVABILITY_SERVICE_NAMESPACE=agent-framework.samples

BEARER_TOKEN=
OPENAI_MODEL=

# Local testing default from the Configure Agent Testing guide:
# 1. Keep USE_AGENTIC_AUTH=false
# 2. Run `a365 develop get-token`
# 3. Paste the token into BEARER_TOKEN
USE_AGENTIC_AUTH=false

# Agent 365 Agentic Authentication Configuration
# Only required when USE_AGENTIC_AUTH=true and AUTH_HANDLER_NAME=AGENTIC.
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTSECRET=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__SCOPES=

AGENTAPPLICATION__USERAUTHORIZATION__HANDLERS__AGENTIC__SETTINGS__TYPE=AgenticUserAuthorization
AGENTAPPLICATION__USERAUTHORIZATION__HANDLERS__AGENTIC__SETTINGS__SCOPES=https://graph.microsoft.com/.default
AGENTAPPLICATION__USERAUTHORIZATION__HANDLERS__AGENTIC__SETTINGS__ALTERNATEBLUEPRINTCONNECTIONNAME=SERVICE_CONNECTION
AGENTAPPLICATION__USERAUTHORIZATION__HANDLERS__AGENTIC__SETTINGS__ALT_BLUEPRINT_NAME=SERVICE_CONNECTION

CONNECTIONSMAP_0_SERVICEURL=*
CONNECTIONSMAP_0_CONNECTION=SERVICE_CONNECTION

# Optional: Server Configuration
PORT=3978

# Azure OpenAI Configuration
AZURE_OPENAI_API_KEY=
# Use the resource root, for example: https://your-resource.openai.azure.com/
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# Required for observability SDK
ENABLE_OBSERVABILITY=true
ENABLE_A365_OBSERVABILITY_EXPORTER=false
PYTHON_ENVIRONMENT=development

# Enable otel logs on AgentFramework SDK. Required for auto instrumentation
ENABLE_OTEL=true
ENABLE_SENSITIVE_DATA=true
